  direction : input;
  signal_type : "test_scan_in";
 }
 pin(D) {
  direction : input;
 }
 pin(SE) {
  direction : input;
  signal_type : "test_scan_enable";
 }
 pin(CP) {
  direction : input;
 }
 pin(SDN) {
  direction : input;
 }
 pin(CDN) {
  direction : input;
 }
