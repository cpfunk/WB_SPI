test_cell () {
 pin(SI) {
  direction : input;
  signal_type : "test_scan_in";
 }
 pin(D) {
  direction : input;
 }
 pin(E) {
  direction : input;
 }
 pin(SE) {
  direction : input;
  signal_type : "test_scan_enable";
 }
 pin(CP) {
  direction : input;
 }
ff("IQ","IQN") {
 next_state : "IQ * E'+ D * E";
 clocked_on : "CP";
}
 pin(Q) {
  direction : output;
  signal_type : "test_scan_out"; 
   function :  "IQ";
 }
 pin(QN) {
  direction : output;
  signal_type : "test_scan_out_inverted"; 
   function :  "IQN";
 }
 
} /* end of Single-latch Test_cell */

}

