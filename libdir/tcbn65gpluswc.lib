 next_state : "D";
 clocked_on : "CP";
 clear : "CDN'";
 preset : "SDN'";
 clear_preset_var1 : L;
 clear_preset_var2 : L;
}
 pin(Q) {
  direction : output;
  signal_type : "test_scan_out"; 
   function :  "IQ";
 }
 pin(QN) {
  direction : output;
  signal_type : "test_scan_out_inverted"; 
   function :  "IQN";
 }

} /* end of Single-latch Test_cell */

